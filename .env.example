# =============================================================================
# Crypto Trading Bot - Environment Variables
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# SECURITY: Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Exchange API Credentials (Bybit)
# Get these from: https://www.bybit.com/app/user/api-management
# IMPORTANT: Create keys with NO withdrawal permission for safety
# -----------------------------------------------------------------------------
API_KEY=your_bybit_api_key_here
API_SECRET=your_bybit_api_secret_here

# -----------------------------------------------------------------------------
# Anthropic API Key (for AI Analysis Layer)
# Get this from: https://console.anthropic.com/settings/keys
# Used by the AI analyst to evaluate trade signals
# Approximate cost: $1-6/month depending on trading frequency
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# -----------------------------------------------------------------------------
# CryptoPanic API Token (optional - for news sentiment)
# Get this from: https://cryptopanic.com/developers/api/
# If not set, the bot falls back to RSS feeds for news
# -----------------------------------------------------------------------------
CRYPTOPANIC_TOKEN=

# -----------------------------------------------------------------------------
# Telegram Alerts (for monitoring notifications)
# 1. Create a bot via @BotFather on Telegram
# 2. Get the bot token from BotFather
# 3. Send a message to your bot, then get your chat ID from:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Deployment Configuration
# These are used by docker-compose and deployment scripts
# You usually don't need to change these unless customizing paths
# -----------------------------------------------------------------------------

# Config file selection (default: config.json)
# For YOLO mode: CONFIG_FILE=config_yolo.json and YOLO_MODE=1
CONFIG_FILE=config.json
YOLO_MODE=

# Data directory inside the container (where trades.db and heartbeat are stored)
BOT_DATA_DIR=/app/data

# Backup configuration
BACKUP_DIR=/opt/trading-bot/backups
BACKUP_RETENTION=30

# S3 bucket for remote backups (optional)
# Example: s3://my-trading-bot-backups
S3_BUCKET=

# Remote server for rsync backups (optional)
# Example: user@backuphost:/path/to/backups
REMOTE_BACKUP=

# Monitor state file path — must be on a persistent volume (NOT /tmp, which is
# wiped on reboot and would cause duplicate alerts or missed trade notifications)
MONITOR_STATE_FILE=/opt/trading-bot/monitor-state.json
